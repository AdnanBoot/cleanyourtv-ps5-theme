<?xml version="1.0" encoding="utf-8"?>
<!-- PS5-style top & left scrim over wallpaper:
     - dark top gradient for status bar and top row legibility
     - subtle left shadow for bottom-left app title legibility
     - clear center and lower-right for key art & character display
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top shadow / gradient: darkens top bar and icon row for legibility -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E6000000"
                android:centerColor="#66000000"
                android:endColor="#00000000"
                android:centerY="0.38" />
        </shape>
    </item>
    <!-- Left shadow: subtle gradient on the left behind the title app -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#B3000000"
                android:centerColor="#40000000"
                android:endColor="#00000000"
                android:centerX="0.35" />
        </shape>
    </item>
</layer-list>
