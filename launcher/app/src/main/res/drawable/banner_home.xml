<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for Home tile: Apple-style deep blue/grey gradient with home icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF1E293B" android:endColor="#FF0F172A" />
        </shape>
    </item>
    <item android:width="64dp" android:height="64dp" android:gravity="center"
        android:drawable="@drawable/ic_home_settings" />
</layer-list>
