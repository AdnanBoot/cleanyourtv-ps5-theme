<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream & ClockActivity): clean full-screen photo slideshow, no phone frame, no clock or date. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Slide Layer A for crossfade -->
    <FrameLayout
        android:id="@+id/dreamSlideA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Ambient dimmed background for portrait photos -->
        <ImageView
            android:id="@+id/dreamAmbientA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Scrim to darken ambient background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000" />

        <!-- Pure photo (fitCenter: preserves original aspect ratio, zero stretching) -->
        <ImageView
            android:id="@+id/dreamPhotoA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Slide Layer B for crossfade -->
    <FrameLayout
        android:id="@+id/dreamSlideB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/dreamAmbientB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000" />

        <ImageView
            android:id="@+id/dreamPhotoB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Fallback ambient glow (only if no photos) -->
    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
