<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream & ClockActivity): clean full-screen photo slideshow, no phone frame, no clock or date. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Slide Layer A for crossfade -->
    <FrameLayout
        android:id="@+id/dreamSlideA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Ambient dimmed background for portrait photos -->
        <ImageView
            android:id="@+id/dreamAmbientA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Scrim to darken ambient background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000" />

        <!-- Pure photo (fitCenter: preserves original aspect ratio, zero stretching) -->
        <ImageView
            android:id="@+id/dreamPhotoA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Slide Layer B for crossfade -->
    <FrameLayout
        android:id="@+id/dreamSlideB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/dreamAmbientB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000" />

        <ImageView
            android:id="@+id/dreamPhotoB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Fallback ambient glow & drifting clock (used when no personal photos in screensaver/) -->
    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@font/inter_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#8CFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/inter_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>

</FrameLayout>
