<?xml version="1.0" encoding="utf-8"?>
<!--
  One dock preview card: poster image (2:3) + title below.
  Non-focusable — the whole preview row is visual only; D-pad stays on the dock tiles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:importantForAccessibility="no">

    <!-- Poster: 120×180dp, rounded corners via outline clipping applied in DockPreviewAdapter. -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:focusable="false">

        <ImageView
            android:id="@+id/previewPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- Bottom gradient for title legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/preview_poster_scrim"
            android:focusable="false"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <!-- Title below poster -->
    <TextView
        android:id="@+id/previewTitle"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/inter_regular"
        android:focusable="false"
        android:importantForAccessibility="no" />

</LinearLayout>
